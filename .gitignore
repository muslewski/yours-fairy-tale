# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# payload local-disk upload storage (dev only; prod uses Vercel Blob)
/media
/site-media
next-env.d.ts

# claude / mcp tooling artifacts
.playwright-mcp/
.claude/scheduled_tasks.lock

# brainstorming scratch
.superpowers/

