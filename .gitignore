fairy-tale-mind/.obsidian/workspace*.json
.env

# context-mode nav index (machine-local; content lives in ~/.claude/context-mode)
.navidx-code/
.navidx-mind/
.navidx.log
.navidx.lock
.navidx.stamp
.env*.local
