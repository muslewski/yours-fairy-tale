  "private": true,
  "scripts": {
    "dev": "next dev --no-server-fast-refresh",
    "build": "next build",
    "prebuild": "node scripts/mind/generate.mjs",
    "mind": "node scripts/mind/generate.mjs",
    "start": "next start",
    "payload": "payload",
